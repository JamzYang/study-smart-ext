{
    "name": "StudySmart",
    "version": "1.0",
    "description": "基于AI的Flashcard Generator",
    "manifest_version": 3,
    "background": {
      "service_worker": "src/background/index.jsx",
      "type": "module"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["src/content/index.jsx"],
        "run_at": "document_end"
      }
    ],
    "permissions": ["storage","declarativeContent", "tabs"],
    "host_permissions":[],
    "web_accessible_resources": [
      {
        "resources": [ "images/app.png" ],
        "matches": ["<all_urls>"]
      },
      {
        "resources": [ "insert.js" ],
        "matches": ["https://ant-design.antgroup.com/*"]
      }
    ],
    "action": {
      "default_popup": "index.html",
      "default_icon": {
        "16": "images/app.png",
        "32": "images/app.png",
        "48": "images/app.png",
        "128": "images/app.png"
      },
      "default_title": "Study Smart"
    },
    "icons": {
      "16": "images/app.png",
      "32": "images/app.png",
      "48": "images/app.png",
      "128": "images/app.png"
    }
  }
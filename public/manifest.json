{
  "manifest_version": 3,
  "name": "StudySmart (Dev)",
  "version": "0.1.0",
  "description": "A smart extension for studying, with hot-reloading.",
  "options_page": "index.html",
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "activeTab",
    "scripting"
  ]
}
